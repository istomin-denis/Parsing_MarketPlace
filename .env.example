# Copy to .env before running with Docker Compose.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=marketplace

# This URL is used by the API container. Keep the password in sync above.
DATABASE_URL=postgresql://marketplace:change-this-local-password@db:5432/marketplace

# Generate a long random value for any non-local deployment.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:8080
DEMO_MODE=true
COOKIE_SECURE=false
